# Portal da Ribeirada — política de cache
<IfModule mod_headers.c>
  # HTML: nunca servir versão antiga sem revalidar (apanha atualizações de imediato)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Assets estáticos: cache longa (são versionados via ?v= no HTML)
  <FilesMatch "\.(css|js|jpe?g|png|gif|svg|webp|ico|woff2?|ttf|pdf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
